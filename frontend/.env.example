# Frontend Environment Configuration
# API Base URL - In development, leaving empty or using '/api' uses Vite proxy to backend
# For production or direct cross-origin API calls, provide the full URL:
VITE_API_BASE_URL=http://localhost:5000/api

# Vite Development Server Port
PORT=3000
VITE_PORT=3000

# Backend Target URL for Vite Development Proxy
VITE_BACKEND_URL=http://localhost:5000
